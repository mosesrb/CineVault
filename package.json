{
  "name": "delatron",
  "version": "1.2.8",
  "description": "Proof on concept",
  "main": "index.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "prestart": "node scripts/ensure_local_mongodb.js",
    "start": "node index.js",
    "predev": "node scripts/ensure_local_mongodb.js",
    "dev": "node --watch --watch-preserve-output index.js",
    "frontend": "npm run dev --prefix frontend",
    "prefullstack": "node scripts/ensure_local_mongodb.js",
    "fullstack": "concurrently \"npm run dev\" \"npm run frontend\"",
    "backup:mongo": "node scripts/backup_mongodb.js",
    "copy:mongo": "node scripts/copy_mongodb_database.js",
    "credentials:prepare": "node scripts/prepare_environment.js",
    "migrate:sessions": "node scripts/migrations/001_hash_session_tokens.js",
    "invalidate:sessions": "node scripts/migrations/002_invalidate_sessions_after_jwt_rotation.js",
    "migrate:identity": "node scripts/migrations/003_initialize_server_identity.js",
    "restore:mongo": "node scripts/restore_mongodb_backup.js",
    "verify:phase0": "node scripts/verify_phase0_runtime.js",
    "verify:secrets": "node scripts/check_secret_exposure.js",
    "lint:backend": "eslint app.js index.js middleware models routes services startup scripts tests supabase/tests enrollment supabase/broker",
    "lint:frontend": "eslint frontend/src frontend/vite.config.js",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "audit": "npm audit && npm audit --prefix frontend && npm audit --prefix supabase/tests && npm audit --prefix supabase/broker",
    "test": "jest --runInBand --detectOpenHandles",
    "test:dependency-guards": "node --test scripts/tests/deepmerge.regression.js",
    "test:frontend": "npm test --prefix frontend",
    "test:control-plane": "npm test --prefix supabase/tests",
    "build:frontend": "npm run build --prefix frontend",
    "verify:web": "npm run audit && npm run lint && npm run test:dependency-guards && npm test && npm run test:frontend && npm run test:control-plane && npm run build:frontend"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-mutex": "0.5.0",
    "bcrypt": "6.0.0",
    "config": "4.4.2",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "fluent-ffmpeg": "2.1.3",
    "helmet": "8.3.0",
    "joi": "18.2.9",
    "joi-objectid": "4.0.2",
    "jsonwebtoken": "9.0.3",
    "mongoose": "6.13.11",
    "redis": "6.2.1",
    "winston": "3.19.0",
    "winston-mongodb": "7.0.1"
  },
  "devDependencies": {
    "@cinevault/deepmerge-guard": "file:vendor/deepmerge-guard",
    "@eslint/js": "9.39.5",
    "concurrently": "9.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jest": "30.5.1",
    "supertest": "7.2.2"
  },
  "overrides": {
    "jest-config@30.5.1": {
      "deepmerge": "file:../../vendor/deepmerge-guard"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "concurrently": {
      "shell-quote": "1.11.0"
    }
  },
  "directories": {
    "test": "tests"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/frontend/",
      "<rootDir>/runtime/",
      "<rootDir>/supabase/tests/"
    ]
  }
}
