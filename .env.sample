# CineVault Environment Variables Sample
# Copy this file to `.env`. Never commit the resulting `.env` file.
# Generate independent, high-entropy values for every secret below.

NODE_ENV=production
PORT=3000

# Direct Node.js startup (required; at least 32 random characters)
delatron_jwtPrivateKey=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS

# Optional: The TMDB API key to resolve film metadata (images, cast, summary, etc.)
# If left blank, CineVault uses a skeleton fallback for filenames
delatron_TMDB_API_KEY=

# Required: The MongoDB connection string
delatron_MONGODB_URI=mongodb://localhost:27017/cinevault_production

# Docker Compose startup (all required except TMDB_API_KEY/HOST_MEDIA_PATH)
JWT_PRIVATE_KEY=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS
MONGO_USERNAME=cinevault_admin
MONGO_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_RANDOM_PASSWORD
MONGO_ROOT_USERNAME=cinevault_root
MONGO_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_URL_SAFE_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
TMDB_API_KEY=
HOST_MEDIA_PATH=./media
